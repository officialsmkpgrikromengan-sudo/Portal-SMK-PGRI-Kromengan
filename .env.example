# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# PERINGATAN KEAMANAN: File ini dilacak oleh Git dan TERBUKA UNTUK PUBLIK di GitHub.
# JANGAN PERNAH memasukkan kunci API asli, token, atau kata sandi ke dalam file ini!
# Salin file ini menjadi '.env' di mesin lokal/server Anda dan isi nilai sebenarnya di sana.
# File '.env' sudah terdaftar di .gitignore dan tidak akan pernah terunggah ke GitHub.
# ==============================================================================

# GEMINI_API_KEY: Server-side only secret for Gemini API calls.
# Keep empty here. Set in .env or Cloud Run/hosting secrets environment.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

